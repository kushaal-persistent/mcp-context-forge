# Base path the browser uses to reach the gateway. Keep "/api" and let a proxy forward it.
VITE_API_BASE=/api

# Dev/preview proxy target. Default is the isolated demo gateway (alerting enabled).
# For your real gateway use e.g. http://127.0.0.1:4444 (needs ALERTING_ENABLED=true).
VITE_GATEWAY_URL=http://127.0.0.1:4445
